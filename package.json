{
  "name": "meberra",
  "version": "1.12.1",
  "private": true,
  "description": "Meberra — AP sınavları ve Avrupa'da üniversite hazırlık platformu (Node.js + SQLite)",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"server/test/*.test.js\"",
    "yonetici": "node server/cli.js yonetici-olustur",
    "yedek": "node server/cli.js yedek",
    "test:birim": "node araclar/testler/birim-hepsi.js",
    "test:e2e": "playwright test -c e2e",
    "test:e2e:kur": "playwright install chromium"
  },
  "dependencies": {
    "nodemailer": "^6.9.16",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
