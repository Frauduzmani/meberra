# =====================================================================
# Meberra — ortam değişkenleri örneği
# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun:
#     cp .env.example .env
# .env dosyası GİZLİDİR: git'e eklemeyin, kimseyle paylaşmayın.
# =====================================================================

# --- Çalışma ortamı ---------------------------------------------------
# Canlı sunucuda daima "production" olmalı.
NODE_ENV=production

# Uygulamanın dinlediği port ve adres.
# nginx arkasında 3000 / 0.0.0.0 bırakın (Docker portu yalnızca 127.0.0.1'e açar).
# Docker'sız (systemd) kurulumda HOST=127.0.0.1 daha güvenlidir.
PORT=3000
HOST=0.0.0.0

# Sitenin herkese açık adresi. E-postalardaki bağlantılarda kullanılır.
# Sonunda "/" OLMADAN yazın.
BASE_URL=https://meberra.com

# SQLite veritabanı ve yüklenen dosyaların klasörü.
# Docker'da her zaman /data kullanılır (docker-compose.yml bunu zorlar).
# Docker'sız kurulumda: /opt/meberra/server/data
DATA_DIR=/data

# nginx gibi bir ters vekil (reverse proxy) arkasındaysanız 1 yapın.
# Böylece gerçek ziyaretçi IP'si ve https bilgisi doğru okunur.
TRUST_PROXY=1

# Oturum çerezleri yalnızca HTTPS üzerinden gönderilsin (canlıda 1).
# Bilgisayarınızda http://localhost ile denerken 0 yapın, yoksa giriş yapamazsınız.
COOKIE_SECURE=1

# --- E-posta (SMTP) ---------------------------------------------------
# SMTP_HOST boş bırakılırsa e-postalar GÖNDERİLMEZ; yalnızca veritabanındaki
# giden kutusuna (outbox) kaydedilir ve yönetici panelinden görülebilir.
# Örnekler:
#   Brevo:      smtp-relay.brevo.com   port 587
#   Mailgun:    smtp.eu.mailgun.org    port 587
#   Google Workspace: smtp.gmail.com   port 465 (veya 587) + uygulama şifresi
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Gönderen adı ve adresi (alan adınızda doğrulanmış bir adres olmalı)
SMTP_FROM="Meberra <destek@meberra.com>"

# --- İlk yönetici hesabı ----------------------------------------------
# Uygulama ilk açılışta bu e-posta/şifre ile yönetici hesabı oluşturur.
# GÜVENLİK: İlk başarılı girişten sonra bu iki satırı silin (veya boşaltın)
# ve uygulamayı yeniden başlatın. Alternatif: CLI ile oluşturun:
#   node server/cli.js yonetici-olustur --eposta siz@ornek.com --sifre 'GucluSifre!'
ADMIN_EPOSTA=
ADMIN_SIFRE=

# --- Ödeme (banka havalesi / EFT) -------------------------------------
# Premium üyelik havale ile satılır; bu bilgiler ödeme sayfasında gösterilir.
# Ödeme geldiğinde yönetici panelinden elle onaylanır.
# Boşluk içeren değerleri çift tırnak içine yazın.
BANKA_ADI="Örnek Bankası"
IBAN="TR00 0000 0000 0000 0000 0000 00"
HESAP_SAHIBI="Şirket Ünvanı Ltd. Şti."

# Fiyatlar (TL, tam sayı)
FIYAT_AYLIK=199
FIYAT_YILLIK=1490

# --- Destek -----------------------------------------------------------
# Sitede "bize ulaşın" olarak gösterilen adres
DESTEK_EPOSTA=destek@meberra.com
